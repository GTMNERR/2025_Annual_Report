Freezes<-MET[which(MET$atemp<=0),]
#Create separate date month year columns
Freezes$Month <- format(Freezes$datetimestamp, "%b")
Freezes$Day <- format(Freezes$datetimestamp, "%d")
Freezes$Year <- year(Freezes$datetimestamp)
Freezes$Month_number <- month(Freezes$datetimestamp)
Freezes$Month_Year <- format(Freezes$datetimestamp, "%b %Y")
Freezes$Month_Day_Year <- format(Freezes$datetimestamp, "%b %d %Y")
#Count the number of occurrences where atemp is <=0 in a single year
Yearly_Freezes <- Freezes %>%
group_by(Year) %>%
add_count(Year, name = "YearlyCounts") %>%
ungroup() %>%
select(datetimestamp, Year, YearlyCounts)
#Count the number of monthly freezes where atemp is <=0 in a single year
Monthly_Freezes <- Freezes %>%
group_by(Month_Year) %>%
add_count(Month_Year, name = "MonthlyCounts") %>%
ungroup() %>%
select(datetimestamp, Year, MonthlyCounts)
#Count the number of freeze days where atemp is <=0 in a single year
Number_of_Days <- Freezes %>%
group_by(Month_Day_Year) %>%
distinct(Month_Day_Year, .keep_all = TRUE) %>%
add_count(Month_Day_Year, name = "DailyCounts") %>%
ungroup() %>%
add_count(Year, name = "NumberOfDays") %>%
ungroup() %>%
select(datetimestamp, Year, NumberOfDays)
##Number of occurrences and datetimestamp where the daily mean of atemp is <=0
DailyMeanFreeze <- aggreswmp(MET, by='days', params = 'atemp', FUN='mean') %>%
filter(atemp <= 0) %>%
add_count(atemp, name = "Number_of_Daily_Means") %>%
ungroup()
DailyMeanFreeze$Year <- year(DailyMeanFreeze$datetimestamp)
#Join table information
Freeze_Table <- Yearly_Freezes %>%
full_join(Monthly_Freezes) %>%
full_join(Number_of_Days) %>%
full_join(DailyMeanFreeze)
#Extract only the information needed for final table and print final table in report
Filtered_Table <- Freeze_Table %>%
arrange(Year, Number_of_Daily_Means) %>%
distinct(Year, .keep_all = TRUE)  %>%
select(Year, YearlyCounts, MonthlyCounts, DailyCounts, Number_of_Daily_Means) %>%
rename()
